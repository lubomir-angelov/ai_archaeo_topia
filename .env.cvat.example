# CVAT environment configuration
# Copy this file to .env.cvat and adjust as needed.
# Do NOT commit .env.cvat with real credentials.

# CVAT server host (for browser access)
CVAT_HOST=localhost

# CVAT UI port (host)
CVAT_PORT=9090

# CVAT share port (for image serving)
CVAT_SHARE_PORT=7777

# PostgreSQL host port mapping
POSTGRES_PORT=5431

# Optional: PostgreSQL credentials (defaults are fine for local dev)
# POSTGRES_USER=cvat
# POSTGRES_PASSWORD=cvat
# POSTGRES_DB=cvat

# Optional: Superuser credentials (set before running cvat-superuser)
# CVAT_SUPERUSER_USERNAME=admin
# CVAT_SUPERUSER_EMAIL=admin@localhost
# CVAT_SUPERUSER_PASSWORD=admin

# Optional: GPU support (set to 1 to enable GPU for Nuclio functions)
# CVAT_GPU_ENABLED=1

# ---- MCP / Annotation pipeline env vars ----
# CVAT_SAM2_CVAT_BASE_URL=http://127.0.0.1:8080
# CVAT_SAM2_CVAT_USERNAME=
# CVAT_SAM2_CVAT_PASSWORD=
# CVAT_SAM2_CVAT_ORG=
# CVAT_SAM2_NUCLIO_DASHBOARD_URL=http://127.0.0.1:8070
# CVAT_SAM2_SAM2_FUNCTION_NAME=pth-facebookresearch-sam-vit-h
# CVAT_SAM2_ANNOTATION_ARTIFACT_ROOT=./artifacts/annotation_runs
# CVAT_SAM2_MCP_LOG_LEVEL=INFO
